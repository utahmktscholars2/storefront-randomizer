generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model AbAssignment {
  id            BigInt   @id @default(autoincrement())
  shop          String?
  experimentKey String   @map("experiment_key")
  visitorId     String   @map("visitor_id")
  sessionId     String?  @map("session_id")
  variant       String
  pageUrl       String?  @map("page_url")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([shop, experimentKey, visitorId, sessionId, pageUrl])
  @@map("ab_assignments")
}

model VariantVisit {
  id            String   @id @default(cuid())
  shop          String
  experimentKey String
  visitorId     String
  sessionId     String?
  variant       String
  pageUrl       String?
  createdAt     DateTime @default(now())

  @@index([shop])
  @@index([experimentKey])
  @@index([visitorId])
  @@index([createdAt])
}

model StorefrontClick {
  id             String   @id @default(cuid())
  shop           String
  experimentKey  String
  visitorId      String
  sessionId      String?
  variant        String
  pageUrl        String?
  clickedAt      DateTime @default(now())
  sequence       Int
  tagName        String?
  elementText    String?
  elementId      String?
  elementClasses String?
  elementHref    String?
  elementRole    String?
  elementName    String?
  selector       String?
  abBlock        String?
  abVariant      String?
  x              Int?
  y              Int?

  @@index([shop])
  @@index([shop, clickedAt])
  @@index([shop, visitorId, sessionId, sequence])
  @@index([experimentKey])
}

model PageDuration {
  id            String   @id @default(cuid())
  pageViewId    String   @unique
  shop          String
  experimentKey String
  visitorId     String
  sessionId     String?
  variant       String
  pageUrl       String?
  startedAt     DateTime
  endedAt       DateTime
  durationMs    Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([shop])
  @@index([shop, startedAt])
  @@index([shop, visitorId, sessionId])
  @@index([experimentKey])
}

model ShopTrackingSettings {
  id                String   @id @default(cuid())
  shop              String   @unique
  trackClicks       Boolean  @default(true)
  trackPageDuration Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

